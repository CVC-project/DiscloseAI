# DART OpenAPI (https://opendart.fss.or.kr → 인증키 신청)
DART_API_KEY=

# 공정위 대규모기업집단 — 공공데이터포털(data.go.kr) 공통 인증키
FTC_API_KEY=

# 한국은행 ECOS OpenAPI (https://ecos.bok.or.kr/api → 인증키 신청) — 산업연관표 등
BOK_ECOS_API_KEY=

# Supabase (프로젝트 리드가 공유)
SUPABASE_URL=
SUPABASE_KEY=

# DB 연결 (Supabase PostgreSQL 직접 연결용, 프로젝트 리드가 공유)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# GitHub Token (https://github.com/settings/tokens → repo 권한)
GITHUB_TOKEN=

# report LLM 서빙 (Phase 4 — A100 SGLang, OpenAI 호환 엔드포인트)
#   `python -m sglang.launch_server --model <MODEL> --port 30000` 뒤 base_url·키 입력. SSH 접속정보는 넣지 않음.
REPORT_LLM_BASE_URL=http://<GPU_IP>:30000/v1
REPORT_LLM_API_KEY=EMPTY
REPORT_LLM_MODEL=Qwen/Qwen3.5-35B-A3B
